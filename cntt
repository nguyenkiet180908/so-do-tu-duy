["Khoa học máy tính","7480101","7480101C","Nền tảng thuật toán, cấu trúc dữ liệu, trí tuệ nhân tạo và hệ thống máy tính.","Software Developer, AI/ML Engineer, nghiên cứu.","Theo trang tuyển sinh IUH: đào tạo kỹ sư có đạo đức nghề nghiệp, nắm vững kiến thức cơ bản và chuyên sâu về khoa học máy tính để nghiên cứu, phát triển và ứng dụng CNTT."],
["Kỹ thuật phần mềm","7480103","7480103C","Quy trình xây dựng phần mềm: phân tích yêu cầu, thiết kế, lập trình, kiểm thử và bảo trì.","Software/Full-stack Developer, QA/QC."],
["Công nghệ thông tin","7480201","7480201C","Ứng dụng, triển khai và vận hành hệ thống CNTT: phần mềm, mạng, cơ sở dữ liệu, an toàn thông tin.","Developer, System/Network, Cloud/DevOps, An toàn thông tin."],
["Hệ thống thông tin","7480104","7480104C","Phân tích, thiết kế và quản lý hệ thống thông tin, dữ liệu cho tổ chức.","Data Analyst, Developer, phân tích nghiệp vụ."],
["Chuyên ngành Trí tuệ nhân tạo","7480101 (mã nhóm)","Chưa thấy công bố","Học máy, xử lý dữ liệu và xây dựng hệ thống thông minh.","AI/ML Engineer, Data Analyst."],
["Chuyên ngành Khoa học dữ liệu","7480101 (mã nhóm)","Chưa thấy công bố","Thu thập, phân tích, trực quan hóa dữ liệu để hỗ trợ ra quyết định.","Data Analyst, Data Engineer."]];
$('#fit').innerHTML=FIT.map((f,i)=>`<button class="card fc2 rv" data-i="${i}" aria-haspopup="dialog"><span class="tag">Mã ${f[1]}</span><h3>${f[0]}</h3><p>${f[3]}</p><span class="more">Xem chi tiết →</span></button>`).join('');
$('#fit').onclick=e=>{const b=e.target.closest('.fc2');if(!b)return;const f=FIT[b.dataset.i];det(f[0],[["Mã ngành (Cẩm nang người học IUH)",f[1]],["Chương trình tăng cường tiếng Anh",f[2]],...(f[5]?[["Mục tiêu đào tạo",f[5]]]:[]),["Giải thích (kiến thức chung)",f[3]],["Hướng nghề tham khảo",f[4]],["Kiểm tra lại",'Đối chiếu tên ngành, mã và chương trình với đề án tuyển sinh của đúng năm trên website IUH.']])};
/* nav */
const hd=$('#hd'),nv=$('#nv'),mb=$('#mb'),tp=$('#top');
mb.onclick=()=>{const o=nv.classList.toggle('o');mb.setAttribute('aria-expanded',o);mb.setAttribute('aria-label',o?'Đóng menu':'Mở menu')};
const cm=()=>{nv.classList.remove('o');mb.setAttribute('aria-expanded',false);mb.setAttribute('aria-label','Mở menu')};
nv.onclick=e=>{if(e.target.closest('a'))cm()};document.addEventListener('keydown',e=>{if(e.key==='Escape')cm()});
const sc=()=>{hd.classList.toggle('s',scrollY>40||nv.classList.contains('o'));tp.classList.toggle('v',scrollY>700)};addEventListener('scroll',sc,{passive:true});sc();
tp.onclick=()=>scrollTo({top:0});
if('IntersectionObserver'in window){
const links=$$('nav a');
const ao=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)links.forEach(a=>{if(a.getAttribute('href')==='#'+e.target.id)a.setAttribute('aria-current','true');else a.removeAttribute('aria-current')})}),{rootMargin:'-45% 0px -50% 0px'});$$('main section[id]').forEach(s=>ao.observe(s));
const ro=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');ro.unobserve(e.target)}}),{threshold:.1});$$('.rv').forEach(x=>ro.observe(x));
}else $$('.rv').forEach(x=>x.classList.add('in'));
/* theme */
const rt=document.documentElement,sv=store.get('cntt-theme');if(sv)rt.dataset.theme=sv;
$('#th').onclick=()=>{const d=rt.dataset.theme?rt.dataset.theme==='dark':matchMedia('(prefers-color-scheme:dark)').matches;const n=d?'light':'dark';rt.dataset.theme=n;store.set('cntt-theme',n);say(n==='dark'?'Đã bật chế độ tối':'Đã bật chế độ sáng')};
/* share */
$('#sh').onclick=async()=>{const u=location.href.split('#')[0],d={title:document.title,url:u};try{if(navigator.share){await navigator.share(d);return}await navigator.clipboard.writeText(u);say('Đã sao chép liên kết trang')}catch(e){if(e.name!=='AbortError')say('Không thể chia sẻ tự động. Hãy sao chép liên kết từ thanh địa chỉ.')}};
</script>
</body>
</html>

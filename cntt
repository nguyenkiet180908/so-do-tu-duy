<pre><span class="cm"># Từ bài toán thực tế đến giải pháp</span>
<span class="k">def</span> giai_quyet(bai_toan):
    yeu_cau = phan_tich(bai_toan)
    thiet_ke = <span class="k">lap_ke_hoach</span>(yeu_cau)
    san_pham = lap_trinh(thiet_ke)
